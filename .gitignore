# ============================================================
# Dissonance - Assets policy
# ============================================================

# Ignore everything inside Assets by default.
Assets/*

# Keep our source code.
!Assets/Scripts/
!Assets/Scripts/**

# Keep the Unity metadata for our source code.
!Assets/Scripts/**/*.meta

# ============================================================
# Explicitly excluded Unity/XR content
# ============================================================

Assets/Samples/
Assets/VRTemplateAssets/
Assets/XR/
Assets/XRI/

